#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    // マウスカーソル速度を2/3に調整(遅くする)
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                        &zip_mouse_gesture
                        &zip_xy_scaler 1 5>;
    
    scroll_layer: scroll_layer {
        layers = <5>;
        // スクロール速度を1/20に調整
        input-processors = <&zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper>;
    };

    mac_gesture_layer: mac_gesture_layer {
        layers = <1>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &zip_mouse_gesture
                            &zip_xy_scaler 1 5>;
    };

    win_gesture_layer: win_gesture_layer {
        layers = <2>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &win_mouse_gesture
                            &zip_xy_scaler 1 5>;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
